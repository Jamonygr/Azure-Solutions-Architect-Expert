{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:az305:schema:tool-versions:1.0.0", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "verifiedOn", "containerBase", "tools", "graphModules"],
  "properties": {"schemaVersion": {"const": "1.0.0"}, "verifiedOn": {"type": "string", "format": "date"}, "containerBase": {"type": "object", "additionalProperties": false, "required": ["image", "digest"], "properties": {"image": {"const": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04"}, "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}}}, "tools": {"type": "object", "additionalProperties": false, "required": ["powershell", "azureCli", "azModule", "bicep", "azcopy", "python", "node", "pester", "psScriptAnalyzer", "microsoftGraph"], "properties": {"powershell": {"const": "7.6.5"}, "azureCli": {"const": "2.90.0"}, "azModule": {"const": "16.3.0"}, "bicep": {"const": "0.46.1"}, "azcopy": {"const": "10.32.8"}, "python": {"const": "3.12.14"}, "node": {"const": "22.23.2"}, "pester": {"const": "5.7.1"}, "psScriptAnalyzer": {"const": "1.25.0"}, "microsoftGraph": {"const": "2.39.0"}}}, "graphModules": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"pattern": "^Microsoft\\.Graph\\.(Authentication|Users|Groups|Applications|Identity\\.DirectoryManagement|Identity\\.SignIns|Identity\\.Governance|Reports)$"}}}
}
