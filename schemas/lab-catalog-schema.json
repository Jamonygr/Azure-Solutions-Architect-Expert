{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:az305:schema:lab-catalog:1.0.0", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "blueprintEffectiveDate", "expectedLabCount", "instructionalLabCount", "expectedQuestionCount", "navigation", "labs"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "blueprintEffectiveDate": {"const": "2026-04-17"}, "expectedLabCount": {"const": 28}, "instructionalLabCount": {"const": 25}, "expectedQuestionCount": {"const": 1250},
    "navigation": {"type": "object", "additionalProperties": false, "required": ["catalogPath", "firstLabId", "lastLabId", "sequence"], "properties": {"catalogPath": {"const": "labs/README.md"}, "firstLabId": {"const": "LAB-00"}, "lastLabId": {"const": "LAB-27"}, "sequence": {"type": "array", "minItems": 28, "maxItems": 28, "uniqueItems": true, "items": {"pattern": "^LAB-[0-2][0-9]$"}}}},
    "labs": {"type": "array", "minItems": 28, "maxItems": 28, "items": {"$ref": "#/$defs/lab"}}
  },
  "$defs": {"lab": {"type": "object", "additionalProperties": false, "required": ["id", "number", "folder", "title", "domainId", "track", "laneLabel", "implementationMode", "supplementalBicep", "graphPowerShell", "status", "lastLiveVerified", "questionCount", "primaryObjectiveIds", "reinforcesAllOfficialObjectives", "path", "previousLabId", "nextLabId"], "properties": {"id": {"pattern": "^LAB-[0-2][0-9]$"}, "number": {"pattern": "^[0-2][0-9]$"}, "folder": {"pattern": "^[0-2][0-9]-[a-z0-9-]+$"}, "title": {"type": "string"}, "domainId": {"enum": ["FOUNDATION", "IGM", "DATA", "BC", "INF", "CAPSTONE"]}, "track": {"enum": ["dual-bootstrap", "azure-cli", "azure-powershell"]}, "laneLabel": {"type": "string"}, "implementationMode": {"enum": ["design-simulation", "reference-deployable", "safe-analogue"]}, "supplementalBicep": {"type": "boolean"}, "graphPowerShell": {"type": "boolean"}, "status": {"const": "offline-validated"}, "lastLiveVerified": {"type": "null"}, "questionCount": {"enum": [0, 50]}, "primaryObjectiveIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "reinforcesAllOfficialObjectives": {"type": "boolean"}, "path": {"type": "string"}, "previousLabId": {"type": ["string", "null"]}, "nextLabId": {"type": ["string", "null"]}}}}
}
