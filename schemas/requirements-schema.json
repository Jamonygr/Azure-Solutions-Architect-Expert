{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:az305:schema:requirements:1.0.0",
  "title": "AZ-305 lab requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "labId", "businessOutcome", "stakeholders", "functionalRequirements", "nonfunctionalRequirements", "constraints", "assumptions", "facts", "acceptanceCriteria", "changeRequest"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "labId": {"pattern": "^LAB-[0-2][0-9]$"},
    "businessOutcome": {"type": "string", "minLength": 20},
    "stakeholders": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "functionalRequirements": {"$ref": "#/$defs/requirements"},
    "nonfunctionalRequirements": {"$ref": "#/$defs/requirements"},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "facts": {
      "type": "object", "additionalProperties": false,
      "required": ["data", "scale", "latency", "availability", "rto", "rpo", "budget"],
      "properties": {
        "data": {"type": "string", "minLength": 30}, "scale": {"type": "string", "minLength": 30}, "latency": {"type": "string", "minLength": 30},
        "availability": {"type": "string", "minLength": 30}, "rto": {"type": "string", "minLength": 30}, "rpo": {"type": "string", "minLength": 30}, "budget": {"type": "string", "minLength": 30}
      }
    },
    "acceptanceCriteria": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 8}},
    "changeRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "trigger", "materialChange", "mandatoryRequirementId", "expectedRevision"],
      "properties": {
        "id": {"pattern": "^LAB[0-2][0-9]-CR-01$"}, "trigger": {"type": "string", "minLength": 10},
        "materialChange": {"type": "string", "minLength": 10}, "mandatoryRequirementId": {"pattern": "^LAB[0-2][0-9]-REQ-[0-9]{2}$"},
        "expectedRevision": {"type": "string", "minLength": 15}
      }
    }
  },
  "$defs": {
    "requirements": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "statement", "mandatory", "objectiveIds"],
        "properties": {
          "id": {"pattern": "^LAB[0-2][0-9]-REQ-[0-9]{2}$"}, "statement": {"type": "string", "minLength": 10},
          "mandatory": {"type": "boolean"}, "objectiveIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
