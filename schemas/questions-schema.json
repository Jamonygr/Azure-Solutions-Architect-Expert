{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:az305:schema:questions:1.0.0",
  "title": "AZ-305 assessment bank",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "labId", "questions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "labId": {"pattern": "^LAB-(0[1-9]|1[0-9]|2[0-5])$"},
    "questions": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {"question": {"type": "object", "additionalProperties": false, "required": ["id", "difficulty", "objectiveId", "checkpointId", "stem", "options", "answer", "explanations", "remediationAnchor", "source", "verifiedOn"], "properties": {
    "id": {"pattern": "^LAB[0-2][0-9]-Q(0[1-9]|[1-4][0-9]|50)$"}, "difficulty": {"enum": ["foundational", "applied", "advanced"]}, "objectiveId": {"type": "string"}, "checkpointId": {"pattern": "^LAB[0-2][0-9]-CP0[1-5]$"}, "stem": {"type": "string", "minLength": 35},
    "options": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"type": "string"}, "B": {"type": "string"}, "C": {"type": "string"}, "D": {"type": "string"}}}, "answer": {"enum": ["A", "B", "C", "D"]},
    "explanations": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"type": "string", "minLength": 12}, "B": {"type": "string", "minLength": 12}, "C": {"type": "string", "minLength": 12}, "D": {"type": "string", "minLength": 12}}}, "remediationAnchor": {"pattern": "^checkpoint-[1-5]$"}, "source": {"type": "string", "format": "uri", "pattern": "^https://learn\\.microsoft\\.com/"}, "verifiedOn": {"type": "string", "format": "date"}
  }}}
}
