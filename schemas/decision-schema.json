{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:az305:schema:decision:1.0.0",
  "title": "AZ-305 architecture decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "labId", "implementationMode", "criteria", "candidates", "selectedCandidate", "rejectedAlternatives", "risks", "waf", "safeAnalogue", "traceability", "adr", "revisedDecision"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "labId": {"pattern": "^LAB-[0-2][0-9]$"},
    "implementationMode": {"enum": ["design-simulation", "reference-deployable", "safe-analogue"]},
    "criteria": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/criterion"}},
    "candidates": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}},
    "selectedCandidate": {"type": "string"},
    "rejectedAlternatives": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["candidate", "reason"], "properties": {"candidate": {"type": "string"}, "reason": {"type": "string", "minLength": 8}}}},
    "risks": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["risk", "mitigation"], "properties": {"risk": {"type": "string", "minLength": 30}, "mitigation": {"type": "string", "minLength": 30}}}},
    "waf": {"$ref": "#/$defs/waf"},
    "safeAnalogue": {"type": ["string", "null"]},
    "traceability": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["objectiveId", "requirementId", "checkpointId"], "properties": {"objectiveId": {"type": "string"}, "requirementId": {"pattern": "^LAB[0-2][0-9]-REQ-[0-9]{2}$"}, "checkpointId": {"pattern": "^LAB[0-2][0-9]-CP0[1-5]$"}}}},
    "adr": {"type": "object", "additionalProperties": false, "required": ["id", "status", "context", "decision", "consequences"], "properties": {"id": {"pattern": "^ADR-LAB[0-2][0-9]-001$"}, "status": {"enum": ["accepted", "superseded"]}, "context": {"type": "string", "minLength": 15}, "decision": {"type": "string", "minLength": 15}, "consequences": {"type": "array", "minItems": 2, "items": {"type": "string"}}}},
    "revisedDecision": {"type": "object", "additionalProperties": false, "required": ["changeRequestId", "selectedCandidate", "reason", "mandatoryRequirementId", "waf"], "properties": {"changeRequestId": {"pattern": "^LAB[0-2][0-9]-CR-01$"}, "selectedCandidate": {"type": "string"}, "reason": {"type": "string", "minLength": 50}, "mandatoryRequirementId": {"pattern": "^LAB[0-2][0-9]-REQ-[0-9]{2}$"}, "waf": {"$ref": "#/$defs/waf"}}}
  },
  "$defs": {
    "waf": {"type": "object", "additionalProperties": false, "required": ["reliability", "security", "costOptimization", "operationalExcellence", "performanceEfficiency"], "properties": {"reliability": {"type": "string", "minLength": 30}, "security": {"type": "string", "minLength": 30}, "costOptimization": {"type": "string", "minLength": 30}, "operationalExcellence": {"type": "string", "minLength": 30}, "performanceEfficiency": {"type": "string", "minLength": 30}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["id", "name", "weight"], "properties": {"id": {"pattern": "^C[0-9]+$"}, "name": {"type": "string"}, "weight": {"type": "integer", "minimum": 1, "maximum": 100}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["id", "name", "eligible", "disqualifiers", "scores", "weightedTotal", "rationale"], "properties": {"id": {"pattern": "^CAND-[A-Z]$"}, "name": {"type": "string"}, "eligible": {"type": "boolean"}, "disqualifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 20}}, "scores": {"type": "object", "additionalProperties": false, "required": ["C1", "C2", "C3", "C4", "C5"], "properties": {"C1": {"type": "integer", "minimum": 1, "maximum": 5}, "C2": {"type": "integer", "minimum": 1, "maximum": 5}, "C3": {"type": "integer", "minimum": 1, "maximum": 5}, "C4": {"type": "integer", "minimum": 1, "maximum": 5}, "C5": {"type": "integer", "minimum": 1, "maximum": 5}}}, "weightedTotal": {"type": "number", "minimum": 0, "maximum": 100}, "rationale": {"type": "string", "minLength": 40}}}
  }
}
